# =============================================================================
# aftercitizen-bg — environment configuration
# =============================================================================
#
# THE RULE
#
#   Anything prefixed VITE_ is inlined into the JavaScript bundle at build time
#   and is readable by anyone who opens the site and views source. It is not
#   hidden by the login: static assets are served before authentication.
#
#   This is a citizen-facing platform holding names, addresses and identity
#   documents. A Baserow token in the bundle is not a configuration mistake,
#   it is a disclosure of every row it can reach.
#
#   So: VITE_ is for PUBLIC configuration only. `npm run build` fails if a
#   secret-shaped VITE_ variable appears (scripts/check-vite-env.mjs), and
#   again if the built bundle contains a credential (scan-dist-secrets.mjs).
#
# =============================================================================


# -----------------------------------------------------------------------------
# PUBLIC — safe in the bundle
# -----------------------------------------------------------------------------

# Auth0. The SPA client id is designed to be public — it is already visible in
# every login redirect.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_DB_CONNECTION=


# -----------------------------------------------------------------------------
# SERVER-SIDE — credentials and data configuration.
# NEVER prefix any of these with VITE_.
#
# Set these in Netlify under Site settings → Environment variables. They are
# read only by netlify/functions/* at request time.
# -----------------------------------------------------------------------------

# --- Baserow (netlify/functions/_shared/baserow.mjs) ---
BASEROW_API=https://db2.aftergroup.org
# Database token for DB 265. Scope it to this database only — the previous
# token carried workspace-wide delete across every Aftergroup database.
BASEROW_TOKEN=

# --- Function authentication (netlify/functions/_shared/auth.mjs) ---
# The SPA requests no custom API audience today, so the functions verify the
# Auth0 ID token, whose audience is the SPA client id.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
# PREFERRED HARDENING: register an Auth0 API, set its identifier as
# `authorizationParams.audience` in src/App.tsx, and put it here. The
# verification code already accepts either.
AUTH0_AUDIENCE=

# --- Table ids ---
# Defaults in _shared/baserow.mjs match DB 265; override only if they differ.
BASEROW_CATEGORIES_TABLE_ID=2631
BASEROW_MUNICIPALITIES_TABLE_ID=2632
BASEROW_FIELD_TYPES_TABLE_ID=2634
BASEROW_FORM_SECTIONS_TABLE_ID=2635
BASEROW_DICTIONARIES_TABLE_ID=2636
BASEROW_DICTIONARY_ENTRIES_TABLE_ID=2637
BASEROW_FORM_TEMPLATES_TABLE_ID=2638
BASEROW_FIELDS_TABLE_ID=2639
BASEROW_SERVICES_TABLE_ID=2640
BASEROW_FORMS_TABLE_ID=2643
BASEROW_FORM_FIELDS_TABLE_ID=2645
BASEROW_SUBMISSIONS_TABLE_ID=2647
BASEROW_SUBMISSION_VALUES_TABLE_ID=2648
BASEROW_USER_ROLES_TABLE_ID=2655
BASEROW_MUNICIPAL_UNIT_TYPES_TABLE_ID=2656
BASEROW_ADMIN_USERS_TABLE_ID=2657
BASEROW_MUNICIPAL_DEPARTMENTS_TABLE_ID=2658
BASEROW_IDENTITY_DOCUMENTS_TABLE_ID=2659
BASEROW_ADDRESSES_TABLE_ID=2660
BASEROW_COUNTRIES_TABLE_ID=2654
BASEROW_CURRENCIES_TABLE_ID=2653
BASEROW_SETTINGS_TABLE_ID=2663

# --- Application ---
# Target email for submitted applications.
SUBMISSION_EMAIL=deloviodstvo@triaditza.bg
